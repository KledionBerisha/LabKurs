package com.example.labkursSpring.controller;

import com.example.labkursSpring.model.Doktori;
import com.example.labkursSpring.model.Infermieri;
import com.example.labkursSpring.model.Users;
import com.example.labkursSpring.repository.DoktoriRepo;
import com.example.labkursSpring.repository.InfermieriRepo;
import com.example.labkursSpring.repository.UserRepo;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.ResponseEntity;
import org.springframework.security.core.context.SecurityContextHolder;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;
import org.springframework.web.bind.annotation.PutMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.http.HttpStatus;
import org.springframework.security.crypto.password.PasswordEncoder;

import java.util.HashMap;
import java.util.Map;
import java.util.Optional;

@RestController
@RequestMapping("/api/users")
public class UserController {

    @Autowired
    private UserRepo userRepo;

    @Autowired
    private InfermieriRepo infermieriRepo;

    @Autowired
    private DoktoriRepo doktoriRepo;

         @Autowired
     private PasswordEncoder passwordEncoder;
 
     // DTO for profile updates
     public static class UpdateProfileRequest {
         public String emriMbiemri;
         public String email;
         public String currentPassword;
         public String newPassword;
         // getters/setters optional (Jackson will set fields directly)
     }
 
     /**
      * Update authenticated user's profile.
      * Requires currentPassword to match stored password. If newPassword provided it will be set.
      */
     @PutMapping("/profile")
     public ResponseEntity<?> updateProfile(@RequestBody UpdateProfileRequest req) {
         String principal = SecurityContextHolder.getContext().getAuthentication() != null
                 ? SecurityContextHolder.getContext().getAuthentication().getName()
                 : null;
         if (principal == null) {
             return ResponseEntity.status(HttpStatus.UNAUTHORIZED).body("Unauthorized");
         }
 
         Optional<Users> uopt = userRepo.findByEmail(principal);
         if (uopt.isEmpty()) {
             return ResponseEntity.status(HttpStatus.NOT_FOUND).body("User not found");
         }
         Users user = uopt.get();
 
         if (req.currentPassword == null || req.currentPassword.isBlank()) {
             return ResponseEntity.badRequest().body("Current password is required");
         }
 
         // verify current password using configured PasswordEncoder
         if (!passwordEncoder.matches(req.currentPassword, user.getPassword())) {
             return ResponseEntity.status(HttpStatus.UNAUTHORIZED).body("Current password is incorrect");
         }
 
         // apply email change if provided
         if (req.email != null && !req.email.isBlank()) {
             user.setEmail(req.email);
         }
 
         // update password if requested
         if (req.newPassword != null && !req.newPassword.isBlank()) {
             user.setPassword(passwordEncoder.encode(req.newPassword));
         }
 
         userRepo.save(user);
 
         // also update linked Infermieri/Doktori emriMbiemri if present
         if (user.getUserId() != null) {
             Long uid = user.getUserId();
             Optional<Infermieri> infOpt = infermieriRepo.findByUser_UserId(uid);
             if (infOpt.isPresent()) {
                 Infermieri i = infOpt.get();
                 if (req.emriMbiemri != null) i.setEmriMbiemri(req.emriMbiemri);
                 infermieriRepo.save(i);
                 Map<String,Object> resp = new HashMap<>();
                 resp.put("email", user.getEmail());
                 resp.put("emriMbiemri", i.getEmriMbiemri());
                 resp.put("username", i.getUsername());
                 resp.put("role", "INFERMIER");
                 resp.put("id", i.getInfermieriID());
                 return ResponseEntity.ok(resp);
             }
             Optional<Doktori> dokOpt = doktoriRepo.findByUser_UserId(uid);
             if (dokOpt.isPresent()) {
                 Doktori d = dokOpt.get();
                 if (req.emriMbiemri != null) d.setEmriMbiemri(req.emriMbiemri);
                 doktoriRepo.save(d);
                 Map<String,Object> resp = new HashMap<>();
                 resp.put("email", user.getEmail());
                 resp.put("emriMbiemri", d.getEmriMbiemri());
                 resp.put("username", d.getUsername());
                 resp.put("role", "DOCTOR");
                 resp.put("id", d.getDoktoriId());
                 return ResponseEntity.ok(resp);
             }
         }
 
         // fallback response with basic info
         Map<String,Object> resp = new HashMap<>();
         resp.put("email", user.getEmail());
         resp.put("id", user.getUserId());
         resp.put("role", "USER");
         resp.put("emriMbiemri", req.emriMbiemri != null ? req.emriMbiemri : null);
         return ResponseEntity.ok(resp);
     }

    @GetMapping("/me")
    public ResponseEntity<?> me() {
        String principal = SecurityContextHolder.getContext().getAuthentication() != null
                ? SecurityContextHolder.getContext().getAuthentication().getName()
                : null;

        Map<String, Object> resp = new HashMap<>();
        resp.put("email", principal);
        resp.put("username", null);
        resp.put("emriMbiemri", null);
        resp.put("role", "USER");
        resp.put("id", null);

        // Try to load Users row by email (principal)
        Users user = null;
        if (principal != null) {
            Optional<Users> uopt = userRepo.findByEmail(principal);
            if (uopt.isPresent()) user = uopt.get();
        }

        // If we found Users row, try by user id first
        if (user != null && user.getUserId() != null) {
            Long uid = user.getUserId();
            Optional<Infermieri> infOpt = infermieriRepo.findByUser_UserId(uid);
            if (infOpt.isPresent()) {
                Infermieri i = infOpt.get();
                resp.put("role", "INFERMIER");
                resp.put("id", i.getInfermieriID());
                resp.put("username", i.getUsername());
                resp.put("emriMbiemri", i.getEmriMbiemri());
                resp.put("email", user.getEmail());
                return ResponseEntity.ok(resp);
            }
            Optional<Doktori> dokOpt = doktoriRepo.findByUser_UserId(uid);
            if (dokOpt.isPresent()) {
                Doktori d = dokOpt.get();
                resp.put("role", "DOCTOR");
                resp.put("id", d.getDoktoriId());
                resp.put("username", d.getUsername());
                resp.put("emriMbiemri", d.getEmriMbiemri());
                resp.put("email", user.getEmail());
                return ResponseEntity.ok(resp);
            }
        }

        // Fallbacks: try to find by username or by user email in the specific repos
        if (principal != null) {
            Optional<Infermieri> infByUsername = infermieriRepo.findByUsernameIgnoreCase(principal);
            if (infByUsername.isPresent()) {
                Infermieri i = infByUsername.get();
                resp.put("role", "INFERMIER");
                resp.put("id", i.getInfermieriID());
                resp.put("username", i.getUsername());
                resp.put("emriMbiemri", i.getEmriMbiemri());
                resp.put("email", i.getUser() != null ? i.getUser().getEmail() : resp.get("email"));
                return ResponseEntity.ok(resp);
            }

            Optional<Doktori> dokByUsername = doktoriRepo.findByUsernameIgnoreCase(principal);
            if (dokByUsername.isPresent()) {
                Doktori d = dokByUsername.get();
                resp.put("role", "DOCTOR");
                resp.put("id", d.getDoktoriId());
                resp.put("username", d.getUsername());
                resp.put("emriMbiemri", d.getEmriMbiemri());
                resp.put("email", d.getUser() != null ? d.getUser().getEmail() : resp.get("email"));
                return ResponseEntity.ok(resp);
            }

            Optional<Infermieri> infByEmail = infermieriRepo.findByUser_EmailIgnoreCase(principal);
            if (infByEmail.isPresent()) {
                Infermieri i = infByEmail.get();
                resp.put("role", "INFERMIER");
                resp.put("id", i.getInfermieriID());
                resp.put("username", i.getUsername());
                resp.put("emriMbiemri", i.getEmriMbiemri());
                resp.put("email", principal);
                return ResponseEntity.ok(resp);
            }

            Optional<Doktori> dokByEmail = doktoriRepo.findByUser_EmailIgnoreCase(principal);
            if (dokByEmail.isPresent()) {
                Doktori d = dokByEmail.get();
                resp.put("role", "DOCTOR");
                resp.put("id", d.getDoktoriId());
                resp.put("username", d.getUsername());
                resp.put("emriMbiemri", d.getEmriMbiemri());
                resp.put("email", principal);
                return ResponseEntity.ok(resp);
            }
        }

        // final fallback: return Users basic info if available
        if (user != null) {
            resp.put("email", user.getEmail());
            resp.put("id", user.getUserId());
        }

        return ResponseEntity.ok(resp);
    }
}